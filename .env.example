# =============================================================================
# Agent Factory — Environment Template
# =============================================================================
# 1. COPY this file to '.env' (it is ignored by git — see .gitignore).
# 2. Fill in the keys/endpoints that apply to your providers.
# 3. Lines are parsed as `KEY=value`; inline comments (`#`) are supported.
#    Blank lines and lines starting with `#` are skipped.
#
# This file is loaded automatically at startup (before any CLI command runs).
# Override the file location with:  python -m agent_factory <cmd> --env path/to/.env
# -----------------------------------------------------------------------------

# ---- Provider selection -----------------------------------------------------
# Which provider handles roles that don't set their own `provider:` field.
#
# Options:
#   openai   Cloud models (gpt-4o, gpt-4o-mini, ...). Requires OPENAI_API_KEY.
#   ollama   Local models via a running Ollama server (gemma4:12b, qwen2.5:7b,
#            llama3, ...). No API key; set OLLAMA_BASE_URL if not the default.
#   fake     Offline echo client. No network, deterministic — for tests only.
#
# Default if unset: openai
AGENT_FACTORY_PROVIDER=ollama

# ---- Provider access keys ---------------------------------------------------
# OpenAI (default provider) ---------------------------------------------------
OPENAI_API_KEY=sk-

# Optional: point at an OpenAI-compatible endpoint instead of the default API.
# OPENAI_BASE_URL=https://my-proxy.example.com/v1

# Corporate networks with TLS-intercepting proxies (SSL "self-signed
# certificate in certificate chain" errors): preferred fix is pointing
# REQUESTS_CA_BUNDLE at your company root CA .pem; as a last resort set
# OPENAI_VERIFY_SSL=0 to skip certificate verification (less secure).
# REQUESTS_CA_BUNDLE=C:\certs\corp-root.pem
# OPENAI_VERIFY_SSL=0

# Ollama (local models — no API key needed, but a server must be running) -----
# Defaults to http://localhost:11434 if left blank.
OLLAMA_BASE_URL=
# (no OLLAMA_API_KEY required)

# ---- web_fetch host allowlist (SSRF protection) -----------------------------
# Comma-separated hostnames the 'web_fetch' tool is allowed to reach (subdomains
# of a listed host are permitted too). With this unset, ALL web_fetch calls are
# blocked — see docs/architecture/SSRF_PROTECTION.md.
# Set to '*' to allow every public host (disables the domain check only; the
# scheme/port/private-IP/cloud-metadata protections still apply). Only do this
# for trusted, low-risk research roles — it widens the SSRF attack surface.
# AGENT_FACTORY_WEB_ALLOWED_HOSTS=example.com,docs.example.com

# ---- Model selection (per tier & per role) ---------------------------------
# These map *logical names* used in org/role YAML to concrete provider models.
#
# A role's `model:` field (in orgs/<Org>/roles/<role>.yaml) resolves as:
#   MODEL_<role_id>  →  MODEL_<default model>  →  built-in default
#
# Example: if worker_coder_1 has `model: big`, the env var MODEL_big is used.
# If worker_writer_1 has `model: ollama/gemma2`, the OLLAMA_ vars apply.
# -----------------------------------------------------------------------------

# Default models — used when a role does not override `model:` -----------------
# MODEL_default applies to ALL providers; MODEL_fast/smart/big override it per
# tier. Provider-specific vars (OPENAI_MODEL_*, OLLAMA_MODEL_*) win over these.
MODEL_default=gemma4:12b
MODEL_fast=
MODEL_smart=
MODEL_big=

# Provider-specific model overrides — win over MODEL_default/fast/smart/big,
# lose to MODEL_<role_id> and a role's own `model:` field. Uncomment as needed.
# OPENAI_MODEL=gpt-4o-mini            # OPENAI_MODEL_FAST/SMART/BIG win over this
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_SMART=gpt-4o
# OPENAI_MODEL_BIG=gpt-4o
# OLLAMA_MODEL=gemma4                 # OLLAMA_MODEL_FAST/SMART/BIG win over this
# OLLAMA_MODEL_FAST=qwen2.5:0.5b
# OLLAMA_MODEL_SMART=gemma4:12b
# OLLAMA_MODEL_BIG=gemma3:12b

# Per-role model overrides (keyed by the role_id in your org chart) ------------
# Highest priority for a role. The value may be:
#   bare model name      -> uses AGENT_FACTORY_PROVIDER        e.g. gemma4:12b
#   provider/model       -> forces that provider for this role e.g. openai/gpt-4o
#
# Example mix: local default, but the lead runs on OpenAI's big model:
#   MODEL_lead_exec=openai/gpt-4o
#
# Uncomment and edit as needed. Role IDs come from:
#   bootstrap --spec ...  OR  editing orgs/<Org>/roles/<role_id>.yaml
#
# MODEL_worker_research_1=ollama/gemma3:12b
# MODEL_worker_writer_1=gemma4:12b
# MODEL_lead_exec=openai/gpt-4o
# MODEL_amplifier=openai/gpt-4o-mini